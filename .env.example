# Copy this file to .env and fill in your own keys.
# Never commit your real .env file — it's already in .gitignore.

# Supabase — REQUIRED. This is the database and auth for the whole app now
# (replaces the old localStorage version). Get these from your Supabase
# project: Settings → API. See supabase/schema.sql for the database setup
# and README.md for the full walkthrough (including enabling Google sign-in).
VITE_SUPABASE_URL=https://fbsmfltceqzboqnambyb.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImZic21mbHRjZXF6Ym9xbmFtYnliIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODUzMjU0ODMsImV4cCI6MjEwMDkwMTQ4M30.MTLLh6ec_4OwaVwAv5wks3fZoOJdhucqBcYJ5DvJsW0

# TMDB (movies) — https://www.themoviedb.org/settings/api
VITE_TMDB_API_KEY=a13379dd721b2dfc6f13cfb85993568a

# Comics — Google Books API (https://developers.google.com/books)
# CORS-friendly, works directly from the browser. A key is OPTIONAL for
# light/dev usage — Google gives unauthenticated requests a generous free
# quota. Add a key only if you want a higher rate limit.
VITE_GOOGLE_BOOKS_API_KEY=AIzaSyDNMtUhMtArVVWNi07t1y-j2ygVMkCFDWI

# AniList (anime & manga) needs no API key — nothing to configure.

# Paystack — https://dashboard.paystack.com/#/settings/developer
# Use a TEST public key while developing.
VITE_PAYSTACK_PUBLIC_KEY=pk_test_6e1cdd93968a032c2e1dc7c3a2a697fbb7a3deed
